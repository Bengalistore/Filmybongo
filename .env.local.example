# MongoDB Atlas connection string. Create a database user and allow your deployment IP/network.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=atoz_cinemas

# Set a long random secret (at least 32 characters). Do not share it or commit it.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Admin credentials for first-time setup. Use a strong unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

NEXT_PUBLIC_SITE_NAME=ATOZ CINEMAS
NEXT_PUBLIC_SITE_TAGLINE=YOUR MOVIE PARADISE
